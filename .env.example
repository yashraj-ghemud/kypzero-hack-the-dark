# Server
PORT=3000
SITE_URL=http://localhost:3000

# Address emails are sent FROM, and where notifications go
GMAIL_USER=kypzerorg@gmail.com
ORG_EMAIL=kypzerorg@gmail.com

# Email - use ONE of these:
# 1) Brevo HTTP API key (works on Render free, which blocks SMTP). Verify kypzerorg@gmail.com as a sender in Brevo.
BREVO_API_KEY=
# 2) Gmail App Password (works locally / on hosts that allow SMTP)
GMAIL_APP_PASSWORD=

# Permanent storage (MongoDB Atlas connection string). Empty = JSON files in data/.
# Required on Render: without it, registrations are paused because Render's free disk is wiped.
MONGODB_URI=

# Password for the /admin control room
ADMIN_KEY=change-me
